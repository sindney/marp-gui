#pragma once

#include <cstddef>
#include <filesystem>
#include <fstream>
#include <stdexcept>

namespace mg {

// Generated from the source assets; byte arrays preserve Unicode and PNG data.
inline void WriteBuiltinResources(const std::filesystem::path& root) {
    static constexpr unsigned char theme[] = {@builtin_theme@};
    static constexpr unsigned char sample[] = {@builtin_sample@};
    static constexpr unsigned char logo[] = {@builtin_logo@};
    auto write = [&](const char* name, const unsigned char* bytes, std::size_t size) {
        const auto path = root / name;
        std::filesystem::create_directories(path.parent_path());
        std::ofstream out(path, std::ios::binary | std::ios::trunc);
        out.write(reinterpret_cast<const char*>(bytes), static_cast<std::streamsize>(size));
        out.close();
        if (!out) throw std::runtime_error("Cannot write built-in resource: " + path.string());
    };
    write("themes/programmer.css", theme, sizeof(theme));
    write("slides.md", sample, sizeof(sample));
    write("gui/assets/marp_logo.png", logo, sizeof(logo));
}

} // namespace mg
